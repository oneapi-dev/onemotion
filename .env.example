# Where the AI director's requests go. Leave as is to use OneAPI.
ONEAPI_BASE_URL=https://api.oneapi.id/v1
# OneAPI's public model catalog: real prices for briefs that name a model.
ONEAPI_CATALOG_URL=https://oneapi.id/api/public/models
# How long one model step may take before it is given up on, in ms (default
# 570000, about 9.5 minutes). Raise it for long films or slow reasoning models;
# a hosted deployment is also capped by the request limit of its host.
# ONEMOTION_STEP_TIMEOUT_MS=570000
